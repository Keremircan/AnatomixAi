# ANATOMIX.AI ortam değişkenleri — bu dosyayı .env.local olarak kopyalayıp doldurun (.env.local git'e eklenmez).

# Supabase Postgres doğrudan bağlantısı (Dashboard → Connect → Session pooler)
DB_HOST=aws-0-<bolge>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<proje-ref>
DB_PASSWORD=

# Oturum çerezini (JWT) imzalayan gizli anahtar, en az 32 karakter. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
